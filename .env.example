# MiningFOMC V2 Environment Configuration Template
# Copy to .env inside mining-fomc/fomc-app/ and customize paths & secrets.

ENVIRONMENT=development

# ------------------------------------------------------------------ Data Mounts
# Versioned FOMC application database inside ./fomc-data
HOST_FOMC_DATA_DIR=./fomc-data

# Sub-paths inside ./fomc-data
HOST_SIMILARITIES_DIR=./fomc-data/similarities/model=bge-m3/pooling=chunk
HOST_LABELS_DIR=./fomc-data/labels/zero_shot
HOST_RELEVANCE_DIR=./fomc-data/relevance/model

# Local (non-Docker) backend override if running uvicorn directly
# DATA_DIR=./fomc-data

# Gunicorn worker processes; each worker is a separate process with its own memory footprint.
GUNICORN_WORKERS=2

# DuckDB memory & thread caps: higher DUCKDB_THREADS uses more CPU per query, higher limit uses more RAM.
DUCKDB_MEMORY_LIMIT=256MB
DUCKDB_THREADS=1

# Heavy/corpus query admission control on a 2 vCPU box.
HEAVY_QUERY_MAX_CONCURRENCY=1
CORPUS_QUERY_MAX_CONCURRENCY=2
HEAVY_QUERY_MAX_QUEUE=4
HEAVY_QUERY_WAIT_TIMEOUT_S=20
HEAVY_QUERY_GRACE_S=1.2
CORPUS_QUERY_GRACE_S=0.6

# Container memory cap; exceeding it restarts the backend instead of OOM-killing the host.
BACKEND_MEM_LIMIT=1150m

# ------------------------------------------------------------------ Admin Bootstrap
# Root administrator account ensured on backend startup
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@miningfomc.com
ADMIN_PASSWORD=replace-with-strong-admin-password

# ------------------------------------------------------------------ Security & DB
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-64-char-random-hex-secret
JWT_EXPIRE_MINUTES=10080

POSTGRES_DB=miningfomc
POSTGRES_USER=miningfomc
POSTGRES_PASSWORD=replace-with-strong-postgres-password

CORS_ORIGINS=https://miningfomc.com,https://www.miningfomc.com
