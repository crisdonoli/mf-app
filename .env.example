# MiningFOMC V2 Environment Configuration Template
# Copy to .env inside mining-fomc/fomc-app/ and customize paths & secrets.

ENVIRONMENT=development

# ------------------------------------------------------------------ Data Mounts
# Compact, versioned FOMC application database inside ./fomc-data (~167 MB, generated in fomc-db/common/data)
HOST_FOMC_DATA_DIR=./fomc-data

# Sub-paths inside ./fomc-data (override with ../common/data/... or absolute paths if needed)
HOST_SIMILARITIES_DIR=./fomc-data/similarities/model=bge-m3/pooling=chunk
HOST_LABELS_DIR=./fomc-data/labels/zero_shot
HOST_RELEVANCE_DIR=./fomc-data/relevance/model

# Local (non-Docker) backend override if running uvicorn directly
# DATA_DIR=./fomc-data

# DuckDB memory & thread caps
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=4

# ------------------------------------------------------------------ Admin Bootstrap
# Root administrator account ensured on backend startup
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@miningfomc.com
ADMIN_PASSWORD=replace-with-strong-admin-password

# ------------------------------------------------------------------ Security & DB
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-64-char-random-hex-secret
JWT_EXPIRE_MINUTES=10080

POSTGRES_DB=miningfomc
POSTGRES_USER=miningfomc
POSTGRES_PASSWORD=replace-with-strong-postgres-password

CORS_ORIGINS=https://miningfomc.com,https://www.miningfomc.com
